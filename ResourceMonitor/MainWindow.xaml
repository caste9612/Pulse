<rt:ReticleWindow x:Class="ResourceMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:rt="http://schemas.reticle.dev/wpf"
        xmlns:ctrl="clr-namespace:ResourceMonitor.Controls"
        Title="Pulse"
        Width="600" Height="520"
        MinWidth="380" MinHeight="320"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Topmost="True"
        ShowCaption="False"
        ShowFrame="False"
        ContentPadding="0"
        Background="Transparent">

    <!-- Pattern Widget di Reticle (05-pattern.md §14): cornice senza tick, riga di testa da 32,
         sezioni con Panel e Ruler, densità compatta. Niente AllowsTransparency né ombra: il fondo è il backdrop di Windows. -->
    <rt:ReticleWindow.Resources>
        <!-- colori di serie: categorie, non stati. CPU info, GPU success, NET warning, DSK danger vengono dal tema;
             RAM viola e temperature ambra non seguono l'accento: qui i valori del tema scuro, UpdateSeriesBrushes li scurisce sul chiaro -->
        <SolidColorBrush x:Key="RamBrush" Color="#B987F7"/>
        <SolidColorBrush x:Key="TempBrush" Color="#FF8A1F"/>

        <Style x:Key="SectionLabel" TargetType="rt:TrackedText" BasedOn="{StaticResource Reticle.Tracked.Label}">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="BigValue" TargetType="TextBlock" BasedOn="{StaticResource Reticle.Text.DataCompact}">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="InfoText" TargetType="TextBlock" BasedOn="{StaticResource Reticle.Text.Small}">
            <!-- contatori vivi in Small (GHz, VRAM, ping): cifre tabulari come chiede 02-token §5.3 -->
            <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="DimText" TargetType="TextBlock" BasedOn="{StaticResource InfoText}">
            <Setter Property="Foreground" Value="{DynamicResource Reticle.Brush.Text.Muted}"/>
        </Style>
        <Style x:Key="ProcessName" TargetType="TextBlock" BasedOn="{StaticResource InfoText}">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Foreground" Value="{DynamicResource Reticle.Brush.Text.Primary}"/>
        </Style>
        <Style x:Key="ProcessValue" TargetType="TextBlock" BasedOn="{StaticResource Reticle.Text.Mono}">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource Reticle.Brush.Text.Secondary}"/>
        </Style>
        <!-- griglia puntinata sotto le sparkline (D7) -->
        <Style x:Key="SparkBed" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Reticle.Brush.Dots}"/>
            <Setter Property="Margin" Value="14,2,0,2"/>
        </Style>
        <Style x:Key="MetricDivider" TargetType="Rectangle">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Fill" Value="{DynamicResource Reticle.Brush.Line.Subtle}"/>
            <Setter Property="Margin" Value="0,8"/>
        </Style>

        <ContextMenu x:Key="ProcessMenu" x:Shared="False"
                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="Apri cartella file" Click="ProcOpenFolder_Click" CommandParameter="{Binding}"/>
            <MenuItem Header="Propriet&#224; file" Click="ProcProperties_Click" CommandParameter="{Binding}"/>
            <Separator/>
            <MenuItem Header="Termina processo" Click="ProcKill_Click" CommandParameter="{Binding}"/>
            <Separator/>
            <MenuItem Header="Cerca online" Click="ProcSearch_Click" CommandParameter="{Binding}"/>
        </ContextMenu>
        <DataTemplate x:Key="ProcessRowTemplate">
            <Grid Margin="0,1,0,1" Background="Transparent" ContextMenu="{StaticResource ProcessMenu}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name}" Style="{StaticResource ProcessName}"/>
                <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource ProcessValue}" Margin="8,0,0,0"/>
            </Grid>
        </DataTemplate>
    </rt:ReticleWindow.Resources>

    <rt:TickBorder Variant="Frame" ShowTicks="False" Cursor="Arrow">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- riga di testa: marchio con l'accento, nome in Legend, dati vivi in Small, a destra pin e nascondi -->
            <Border x:Name="DragHandle" Grid.Row="0" Height="32" Background="Transparent" Padding="12,0,4,0"
                    MouseLeftButtonDown="DragHandle_MouseLeftButtonDown">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="PinButton" Style="{StaticResource Reticle.Button.Icon}" Height="28"
                                rt:Rt.Icon="M5.5,1.5 H10.5 M6.5,1.5 V6.5 L4.5,9.5 H11.5 L9.5,6.5 V1.5 M8,9.5 V14.5"
                                ToolTip="Sempre in primo piano (clicca per togglare)" Click="PinButton_Click"/>
                        <Button x:Name="HideButton" Style="{StaticResource Reticle.Button.Icon}" Height="28"
                                rt:Rt.Icon="M3,8 H13" ToolTip="Nascondi (resta in tray)" Click="HideButton_Click"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Width="16" Height="16" VerticalAlignment="Center"
                              Stroke="{DynamicResource Reticle.Brush.Accent}" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Data="M 1.6,8 L 5.1,8 L 6.1,9.3 L 7,8 L 8,3.5 L 8.8,12.5 L 9.9,8 L 10.9,8 L 14.4,8"/>
                        <rt:TrackedText Text="Pulse" Style="{StaticResource Reticle.Tracked.Legend}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="UptimeText" Style="{StaticResource InfoText}" Margin="14,0,0,0"/>
                        <TextBlock x:Name="PowerText" Style="{StaticResource InfoText}" Foreground="{DynamicResource TempBrush}" Margin="14,0,0,0"
                                   ToolTip="Consumo PC totale stimato (CPU + GPU + baseline ~30W)"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,2">
                <StackPanel Margin="12,4,12,12">

                    <!-- CPU -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <rt:TrackedText Text="CPU" Style="{StaticResource SectionLabel}" Foreground="{DynamicResource Reticle.Brush.Info}"/>
                            <TextBlock x:Name="CpuValue" Style="{StaticResource BigValue}" Text="—"/>
                            <TextBlock x:Name="CpuClock" Style="{StaticResource InfoText}" Margin="10,0,0,0" Text=""/>
                            <TextBlock x:Name="CpuPower" Style="{StaticResource InfoText}" Margin="10,0,0,0" Text=""/>
                            <TextBlock x:Name="CpuTemp" Style="{StaticResource InfoText}" Margin="10,0,0,0" Foreground="{DynamicResource TempBrush}" Text=""/>
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource SparkBed}">
                            <ctrl:Sparkline x:Name="CpuSpark" Height="26" Stroke="{DynamicResource Reticle.Brush.Info}" MaxValue="100"/>
                        </Border>
                    </Grid>

                    <Rectangle Style="{StaticResource MetricDivider}"/>

                    <!-- RAM -->
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <rt:TrackedText Text="RAM" Style="{StaticResource SectionLabel}" Foreground="{DynamicResource RamBrush}"/>
                                <TextBlock x:Name="RamValue" Style="{StaticResource BigValue}" Text="—"/>
                                <TextBlock x:Name="RamUsed" Style="{StaticResource InfoText}" Margin="10,0,0,0" Text=""/>
                            </StackPanel>
                            <Border Grid.Column="1" Style="{StaticResource SparkBed}">
                                <ctrl:Sparkline x:Name="RamSpark" Height="26" Stroke="{DynamicResource RamBrush}" MaxValue="100"/>
                            </Border>
                        </Grid>
                        <TextBlock x:Name="RamDetail" Style="{StaticResource DimText}" Text="" Margin="0,0,0,2"/>
                    </StackPanel>

                    <Rectangle Style="{StaticResource MetricDivider}"/>

                    <!-- GPU -->
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <rt:TrackedText Text="GPU" Style="{StaticResource SectionLabel}" Foreground="{DynamicResource Reticle.Brush.Success}"/>
                                <TextBlock x:Name="GpuValue" Style="{StaticResource BigValue}" Text="—"/>
                                <TextBlock x:Name="GpuVram" Style="{StaticResource InfoText}" Margin="10,0,0,0" Text=""/>
                                <TextBlock x:Name="GpuTemp" Style="{StaticResource InfoText}" Margin="10,0,0,0" Foreground="{DynamicResource TempBrush}" Text=""/>
                            </StackPanel>
                            <Border Grid.Column="1" Style="{StaticResource SparkBed}">
                                <ctrl:Sparkline x:Name="GpuSpark" Height="26" Stroke="{DynamicResource Reticle.Brush.Success}" MaxValue="100"/>
                            </Border>
                        </Grid>
                        <TextBlock x:Name="GpuDetail" Style="{StaticResource DimText}" Text="" Margin="0,0,0,2"/>
                    </StackPanel>

                    <Rectangle Style="{StaticResource MetricDivider}"/>

                    <!-- NET -->
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <rt:TrackedText Text="NET" Style="{StaticResource SectionLabel}" Foreground="{DynamicResource Reticle.Brush.Warning}"/>
                                <TextBlock x:Name="NetValue" Style="{StaticResource BigValue}" Text="—"/>
                                <TextBlock x:Name="NetPing" Style="{StaticResource InfoText}" Margin="10,0,0,0" Text=""/>
                            </StackPanel>
                            <Border Grid.Column="1" Style="{StaticResource SparkBed}">
                                <ctrl:Sparkline x:Name="NetSpark" Height="26" AutoScale="True" Stroke="{DynamicResource Reticle.Brush.Warning}"/>
                            </Border>
                        </Grid>
                        <TextBlock x:Name="NetDetail" Style="{StaticResource DimText}" Text="" Margin="0,0,0,2"/>
                    </StackPanel>

                    <Rectangle Style="{StaticResource MetricDivider}"/>

                    <!-- DISK -->
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <rt:TrackedText Text="DSK" Style="{StaticResource SectionLabel}" Foreground="{DynamicResource Reticle.Brush.Danger}"/>
                                <TextBlock x:Name="DiskValue" Style="{StaticResource BigValue}" Text="—"/>
                                <TextBlock x:Name="DiskTemp" Style="{StaticResource InfoText}" Margin="10,0,0,0" Foreground="{DynamicResource TempBrush}" Text=""/>
                            </StackPanel>
                            <Border Grid.Column="1" Style="{StaticResource SparkBed}">
                                <ctrl:Sparkline x:Name="DiskSpark" Height="26" AutoScale="True" Stroke="{DynamicResource Reticle.Brush.Danger}"/>
                            </Border>
                        </Grid>
                        <ItemsControl x:Name="DriveList" Margin="0,4,0,2">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,1,0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource InfoText}"/>
                                        <ProgressBar Grid.Column="1" Value="{Binding UsedPercent}" Maximum="100" Margin="0,0,8,0" VerticalAlignment="Center"
                                                     Foreground="{DynamicResource Reticle.Brush.Danger}" Background="{DynamicResource Reticle.Brush.Line.Subtle}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Caption}" Style="{StaticResource ProcessValue}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <rt:Ruler Margin="0,12,0,12"/>

                    <!-- TOP PROCESSES: due Panel con la legenda sulla cornice -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <rt:Panel Grid.Column="0" Legend="Top CPU" Margin="0,0,6,0">
                            <ItemsControl x:Name="TopCpuList" ItemTemplate="{StaticResource ProcessRowTemplate}"/>
                        </rt:Panel>
                        <rt:Panel Grid.Column="1" Legend="Top RAM" Margin="6,0,0,0">
                            <ItemsControl x:Name="TopRamList" ItemTemplate="{StaticResource ProcessRowTemplate}"/>
                        </rt:Panel>
                    </Grid>

                </StackPanel>
            </ScrollViewer>

            <Border x:Name="ResizeGripArea" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Width="22" Height="22" Background="Transparent" Cursor="SizeNWSE"
                    MouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown">
                <Path Width="12" Height="12" Margin="6" Stroke="{DynamicResource Reticle.Brush.Text.Muted}" StrokeThickness="1"
                      IsHitTestVisible="False" Data="M 0,12 L 12,0 M 4,12 L 12,4 M 8,12 L 12,8"/>
            </Border>
        </Grid>
    </rt:TickBorder>
</rt:ReticleWindow>
