<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>Pulse</AssemblyName>
    <RootNamespace>ResourceMonitor</RootNamespace>
    <ApplicationIcon Condition="Exists('Resources\app.ico')">Resources\app.ico</ApplicationIcon>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredCompilation>true</TieredCompilation>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishReadyToRunComposite>true</PublishReadyToRunComposite>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Reticle, la libreria UI: in locale il repository affiancato a questo (Reticle accanto a Pulse); la CI lo scarica
         al tag dichiarato in .github/workflows/release.yml e passa -p:ReticleDir -->
    <ReticleDir Condition="'$(ReticleDir)' == ''">$(MSBuildThisFileDirectory)..\..\Reticle</ReticleDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(ReticleDir)\src\Reticle.Wpf\Reticle.Wpf.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\app.ico" Condition="Exists('Resources\app.ico')" />
  </ItemGroup>

</Project>
