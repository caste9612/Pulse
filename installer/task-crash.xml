<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <!-- Pulse di nuovo in piedi se si chiude per un errore: parte quando il registro Applicazione riceve l'evento 1000
       ("Application Error") dell'exe di Pulse, che Windows scrive anche con Windows Error Reporting spento. Dieci secondi di
       attesa, poi Pulse con l'argomento dopo-crash: aspetta che il processo di prima sia uscito e rifiuta la quarta ripartenza
       in dieci minuti. I diritti sono quelli con cui Pulse parte di solito: amministratore se c'è il task di accesso elevato.
       I nomi dei segnaposto non vanno nei commenti: register-task.ps1 li sostituirebbe anche qui -->
  <RegistrationInfo>
    <Description>Riavvia Pulse se si chiude per un errore, con gli stessi diritti con cui parte di solito.</Description>
  </RegistrationInfo>
  <Triggers>
    <EventTrigger>
      <Enabled>true</Enabled>
      <Subscription>&lt;QueryList&gt;&lt;Query Id="0" Path="Application"&gt;&lt;Select Path="Application"&gt;*[System[Provider[@Name='Application Error'] and EventID=1000]] and *[EventData[Data='PULSE_EXE_NAME']]&lt;/Select&gt;&lt;/Query&gt;&lt;/QueryList&gt;</Subscription>
      <Delay>PT10S</Delay>
    </EventTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <UserId>PULSE_USER</UserId>
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>PULSE_RUNLEVEL</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>Parallel</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <ExecutionTimeLimit>PT0S</ExecutionTimeLimit>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>PULSE_EXE</Command>
      <Arguments>--dopo-crash</Arguments>
    </Exec>
  </Actions>
</Task>
