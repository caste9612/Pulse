<Application x:Class="ResourceMonitor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rt="http://schemas.reticle.dev/wpf"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- default dell'app, pattern Widget di Reticle: trasparenza Mica, che su un widget sempre in primo piano costa meno di Acrylic,
                     densità compatta; l'utente li cambia dal menu di tray (Tema, "Aspetto...") -->
                <rt:ReticleTheme Theme="Dark" Accent="verde" Transparency="Low" Fill="Translucent" Density="Compact" />
                <rt:ReticleControls />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
